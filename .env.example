# Copy this file to .env and fill in your values.
#
# EXPO_PUBLIC_ prefix is required for any variable that needs to be accessible
# in the client bundle. Variables without this prefix are completely stripped
# by Metro at bundle time — they will be undefined at runtime, not just hidden.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# R2 credentials are NOT stored in the app — they live in Supabase function secrets.
# See supabase/functions/r2-sign/index.ts and the deployment instructions in STORAGE.md.
